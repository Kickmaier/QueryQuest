<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QueryQuest.MainPage"
             BackgroundColor="#0b1121"

            Shell.NavBarIsVisible="False"
            Shell.TabBarIsVisible="False"
            Shell.FlyoutBehavior="Disabled">
    <Grid
        ColumnDefinitions="*">
        <BoxView BackgroundColor="#0b1121"/>
        
        <ScrollView
            x:Name="MainView"
            Grid.Column="1">
        <VerticalStackLayout Padding="30,10" Spacing="25">
            <Image Source="queryquestlogo.png"
                HeightRequest="185"
                Aspect="AspectFit" />
            
            <Label Text="QUERY QUEST"
                TextColor="White"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">

                <Label 
                    x:Name="AmountLabel" 
                    Text="{Binding AmountLabelText}"
                    FontSize="16">
                    <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsAmountError}" Value="True">
                            <Setter Property="TextColor" Value="Red" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding IsAmountError}" Value="False">
                        <Setter Property="TextColor" Value="Gold" />
                    </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label
                    x:Name="DifficultyLabel"
                    Text="{Binding DifficultyLabelText}"
                    FontSize="16">
                    <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsDifficultyError}" Value="True">
                        <Setter Property="TextColor" Value="Red"/>
                    </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding IsDifficultyError}" Value="False">
                        <Setter Property="TextColor" Value="Gold"/>
                    </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label 
                    x:Name="CategoryLabel"
                    Text="{Binding CategoryLabelText}"   
                    FontSize="16">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsCategoryError}" Value="True">
                            <Setter Property="TextColor" Value="Red" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding IsCategoryError}" Value="False">
                            <Setter Property="TextColor" Value="Gold"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
            <Button 
                IsEnabled="{Binding CanStartGame}"
                Text="Starta Quiz"
                Clicked="OnGetQuestionClicked"
                BackgroundColor="#1da1f2"
                TextColor="White"
                CornerRadius="15" />
        </VerticalStackLayout>
    </ScrollView>
        <Button 
            Text="≡"
            FontSize="45"
                FontAttributes="Bold"
                TextColor="Gold"
                BackgroundColor="Transparent"
                HorizontalOptions="Start" 
                VerticalOptions="Start"
                
                Clicked="OnToggleMenu" />
        <BoxView x:Name="MenuOverlay" 
                 BackgroundColor="Black" 
                 Opacity="0" 
                 InputTransparent="True">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnToggleMenu" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Frame x:Name="SideMenu"
               Grid.Column="0"
               WidthRequest="280"
               HorizontalOptions="Start"
               TranslationX="-280" 
               BackgroundColor="#151d33"
               BorderColor="#2a3a5c"
               Padding="20"
               CornerRadius="0">

            <VerticalStackLayout Spacing="20">
                <Label Text="INSTÄLLNINGAR" 
                       TextColor="Gold" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       Margin="0,40,0,10"/>

                <Button Text="Längd ∇" Clicked="ToggleAmountSelection" BackgroundColor="#2c3e50" TextColor="White" CornerRadius="15" Margin="0,10,0,0"/>
                <VerticalStackLayout x:Name="AmountSelection" IsVisible="False" Margin="10,0,10,10" Spacing="2">
                    <Button Text="10" TextColor="White" Clicked="SetAmount" CommandParameter="10" BackgroundColor="#34495e" HeightRequest="40"/>
                    <Button Text="25" TextColor="White" Clicked="SetAmount" CommandParameter="25" BackgroundColor="#34495e" HeightRequest="40"/>
                    <Button Text="50" TextColor="White" Clicked="SetAmount" CommandParameter="50" BackgroundColor="#34495e" HeightRequest="40"/>
                </VerticalStackLayout>

                <Button Text="Svårighetsgrad ∇" Clicked="ToggleDifficultySelection" BackgroundColor="#2c3e50" TextColor="White" CornerRadius="15" Margin="0,10,0,0"/>
                <VerticalStackLayout x:Name="DifficultySelection" IsVisible="False" Margin="10,0,10,10" Spacing="2">
                    <Button Text="Blandat" TextColor="White" Clicked="SetDifficulty" BackgroundColor="#34495e" CommandParameter="" CornerRadius="15"/>
                    <Button Text="Lätt" TextColor="White" Clicked="SetDifficulty" BackgroundColor="#34495e" CommandParameter="easy" CornerRadius="15"/>
                    <Button Text="Medel" TextColor="White" Clicked="SetDifficulty" BackgroundColor="#34495e" CommandParameter="medium" CornerRadius="15"/>
                    <Button Text="Svårt" TextColor="White" Clicked="SetDifficulty" BackgroundColor="#34495e" CommandParameter="hard" CornerRadius="15"/>
                </VerticalStackLayout>
                <Button Text="Kategori ∇" Clicked="ToggleCategorySelection" BackgroundColor="#2c3e50" TextColor="White" CornerRadius="15" Margin="0,10,0,0"/>
                <VerticalStackLayout x:Name="CategorySelection" IsVisible="False" Margin="10" Spacing="5">
                    <Button Text="Blandat" TextColor="White" Clicked="SetCategory" CommandParameter="" BackgroundColor="#34495e" CornerRadius="15"/>
                    <Button Text="Allmänbildning" TextColor="White" Clicked="SetCategory" CommandParameter="9" BackgroundColor="#34495e" CornerRadius="15"/>
                    <Button Text="Musik" TextColor="White" Clicked="SetCategory" CommandParameter="12" BackgroundColor="#34495e" CornerRadius="15"/>
                    <Button Text="Historia" TextColor="White" Clicked="SetCategory" CommandParameter="23" BackgroundColor="#34495e" CornerRadius="15"/>
                </VerticalStackLayout>

                <Button Text="STÄNG" 
                        Clicked="OnToggleMenu" 
                        Margin="0,10"
                        BackgroundColor="#2a3a5c" />
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
